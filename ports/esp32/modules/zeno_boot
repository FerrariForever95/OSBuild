# =================================================
# BOOT STRAP (SINGLE THREAD)
# =================================================
import time, gc, os, sys, micropython, machine
from machine import Pin
import zeno
from Graphics import UIScreen, UIText, IOSSlider,color565,UIPanel
from Services import Logger, Network, BootConfig
from firmware import HUIModule


# -------------------------------------------------
# EARLY BOOT MARK
# -------------------------------------------------
print("BOOT_CAP", zeno.boot_cap)
_boot_start = time.ticks_ms()


# -------------------------------------------------
# FIRMWARE RECOVERY
# -------------------------------------------------
try:
    if "firmwarecopy.py" in os.listdir("/LOGS"):
        with open("/LOGS/firmwarecopy.py", "rb") as fsrc:
            data = fsrc.read()

        with open("firmware.py", "wb") as fdest:
            fdest.write(data)

        try:
            zeno.log.debug("Firmware updated successfully", source="BOOT")
        except:
            pass

        os.remove("/LOGS/firmwarecopy.py")

except Exception as e:
    try:
        zeno.log.error(f"Firmware recovery failed: {e}", source="BOOT")
    except:
        print("[BOOT] Firmware recovery failed:", e)


# -------------------------------------------------
# CPU MODE SET
# -------------------------------------------------
_bootcfg = BootConfig()
_cfg = getattr(_bootcfg, "config", {}) or {}

def cfg_get(cfg, *keys):
    for k in keys:
        if k in cfg:
            return cfg[k]
    return None

_mode = str(cfg_get(_cfg, "MODE") or "").upper()

if "PERFORMANCE" in _mode:
    machine.freq(240_000_000)
elif "BALANCED" in _mode:
    machine.freq(160_000_000)
elif "POWERSAVING" in _mode:
    machine.freq(80_000_000)


# -------------------------------------------------
# GLOBAL OBJECT CONSTRUCTION
# -------------------------------------------------
zeno.ui  = HUIModule()
zeno.ui.off()
zeno.net = Network()
zeno.log = Logger(boot=True)


# -------------------------------------------------
# UI INIT (FIRST HARDWARE INIT)
# -------------------------------------------------
try:
    zeno.ui.begin()
    zeno.ui.off()
except Exception as e:
    zeno.log.error(f"UI init failed: {e}", source="BOOT")

gc.collect()
pin=Pin(0,Pin.IN)
if(pin.value()==0):
	raise KeyboardInterrupt

# -------------------------------------------------
# BOOT UI
# -------------------------------------------------
try:
    now = time.ticks_ms()
    zeno.boot_time = time.ticks_diff(now, _boot_start)
    print("BIOS TIME", zeno.boot_time)

    current = zeno.ui.get_brightness()
    zeno.ui.set_brightness(current)

    zeno.ui.on()
    screen=UIScreen(zeno.ui)
    
    # wallpaper
    screen.draw_gradient(zeno.ui,color565(39, 32, 15),color565(100, 83, 44))
    panel=UIPanel(100,25,110,110,None,None,color565(255,255,255))
    panel.draw(zeno.ui)
   # zeno.ui.tft.draw_bmp(zeno.wallpaper,0,0)
    zeno.ui.tft.draw_bmp("/SYSTEM32/RESOURCES/user.bmp",105,30,100,100)
    text=UIText(100,185,"Slide to unlock..",color565(255,255,255),color565(90,90,90))
    UIText(135,150,"Admin",color565(255,255,255),color565(90,90,90)).draw(zeno.ui)
    #text.draw(zeno.ui)
    # slider (AFTER UI INIT)
    slider = IOSSlider(
        x=40,
        y=180,
        w=240,
        min_v=0,
        max_v=100,
        value=0,
        action=None
    )

    slider.draw(zeno.ui)
    text.draw(zeno.ui)
    # -------- LOCK SCREEN LOOP --------
    def lock_screen():
        while True:
            slider.handle_touch(zeno.ui)

            if slider.value >= 95:
                print("lock opened")
                break

            time.sleep_ms(10)  # yield CPU / touch

    #lock_screen()

    zeno.ui.fade_out(0.2)

except Exception as e:
    print(e)
    raise KeyboardInterrupt

gc.collect()
# -------------------------------------------------
# KERNEL LOAD
# -------------------------------------------------
import zfs

zfs.mount()

try:
    src = zfs.read("/kernel.py")
    kernel_globals = {
        "__name__": "__main__",
        "__boot_cap__": zeno.boot_cap,
        "APP_EXIT": Exception
    }
    zeno.ui.clear()
    code = compile(src, "/kernel.py", "exec")
    print("[BOOT] ZFS kernel loaded")
    exec(code, kernel_globals)

except OSError as e:
    print("[BOOT] ZFS kernel load failed:", e)
    # fallback to normal fs
    try:
        with open("/SYSTEM32/OS/kernel.py") as f:
            src = f.read()
        kernel_globals = {
            "__name__": "__main__",
            "__boot_cap__": zeno.boot_cap,
            "APP_EXIT": Exception
        }
        zeno.ui.clear()
        code = compile(src, "/SYSTEM32/OS/kernel.py", "exec")
        exec(code, kernel_globals)
    except Exception as e2:
        print("[BOOT] fallback also failed:", e2)
finally:
    zfs.umount()


